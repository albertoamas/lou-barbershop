POSTGRES_DB=lou_barbershop
POSTGRES_USER=lou
POSTGRES_PASSWORD=replace_for_your_local_environment
POSTGRES_PORT=5432
WEB_PORT=8088

# Datos de prueba locales (deploy/seed-demo.ps1). Contraseñas de 12+ caracteres con
# mayúscula, minúscula, número y símbolo. Nunca reutilizar fuera de este equipo.
LOCAL_OWNER_USERNAME=
LOCAL_OWNER_PASSWORD=
LOU_DEMO_STAFF_PASSWORD=

# Opcionales: sólo enlaces oficiales confirmados. Se incorporan al build del frontend.
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_WHATSAPP_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_TIKTOK_URL=

# Producción puede separar privilegios: migrador con DDL y API sólo con DML.
# No guardar los valores reales en este archivo ni reutilizar las credenciales locales.
# MIGRATION_DATABASE_CONNECTION=Host=...;Database=...;Username=lou_migrator;Password=...;SSL Mode=Require
# RUNTIME_DATABASE_CONNECTION=Host=...;Database=...;Username=lou_runtime;Password=...;SSL Mode=Require
